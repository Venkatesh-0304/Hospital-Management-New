= turbo_frame_tag "tab" do
  %div{style: "display:flex; justify-content:center;"}
    %div
      = form_with url: "/hospitals", method: :get do |form|
        = form.label :query, "Search for"
        = form.search_field :query
        = form.submit "Search"
      %h1{style:"color:navy;"} Hospitals
      = render "notification"
      = turbo_frame_tag "modal"

      = link_to "New hospital", new_hospital_path, data: {turbo_frame: "modal"}

      %table{border: "1"}
        %thead
          %tr
            %th Name
            %th Admin email
            %th Action
        %tbody#hospitals_table_body
          - @hospitals.each do |hospital|
            = render "hospital_row", hospital: hospital
      = paginate @hospitals